# cp .env.example .env 후 값을 채웁니다. .env 는 git 에 올리지 않습니다.
# Grafana Cloud → My Account → 스택 → Prometheus "Details"
GC_PROM_URL=https://prometheus-prod-XX-prod-ap-northeast-0.grafana.net/api/prom/push
GC_PROM_USER=1234567
# Access Policy 토큰 (scope: set:alloy-data-write)
GC_TOKEN=glc_xxx
# MySQL exporter 전용 사용자 (비밀번호는 영숫자만)
MYSQL_DSN=exporter:비밀번호@(host.docker.internal:3306)/
APP_METRICS_ADDR=host.docker.internal:8080
APP_METRICS_PATH=/actuator/prometheus
